# ---- NetOwl - Variables de arranque (bootstrap) ----
# Copie este archivo como .env y complete los valores reales.
#
# IMPORTANTE: aquí NO van credenciales de base de datos ni la SECRET_KEY.
# Todos los secretos viven en HashiCorp Vault; este archivo solo contiene
# lo mínimo para que la aplicación pueda autenticarse contra Vault.
#
# El .env real está en .gitignore y debe tener permisos restringidos:
#   chmod 600 .env

# URL del servidor Vault
VAULT_URL=https://vault.ejemplo.com

# Credenciales del AppRole de la aplicación (política de solo lectura)
VAULT_ROLE_ID=<role_id>
VAULT_SECRET_ID=<secret_id>

# Mount del motor KV v2 y ruta del secreto dentro de ese mount
VAULT_MOUNT_PATH=Desarrollo
VAULT_PATH=external/netowl/qa

# Permite arrancar con DJANGO_SECURE_SSL=false y DJANGO_DEBUG=false, es decir,
# sirviendo por HTTP sin HSTS y con las cookies de sesion y CSRF sin el flag
# Secure. Sin ella la aplicacion se niega a arrancar en esa combinacion: de esa
# unica clave de Vault cuelga toda la postura HTTPS, y olvidarla degradaba la
# seguridad en silencio. **En produccion no debe estar**: ponga
# DJANGO_SECURE_SSL=true en Vault.
#PERMITIR_HTTP_INSEGURO=1

# Esquema de PostgreSQL donde viven las tablas. No es un secreto y cambia
# entre entornos, por eso va aquí: apuntar a producción o a pruebas es
# cuestión de tocar VAULT_PATH y DB_SCHEMA. Por defecto: public
DB_SCHEMA=public

# Cola de tareas: donde escucha Redis y con que indice. Tampoco es un secreto
# y cambia por entorno, igual que DB_SCHEMA.
#
# Los dos entornos comparten el mismo Redis de la MV pero no se mezclan, por dos
# motivos a la vez: cada uno usa su propio indice (0 produccion, 1 desarrollo) y
# el nombre de la cola lleva el sufijo de DB_SCHEMA, asi que un worker solo
# consume analisis encolados por una app que apunte a su mismo esquema.
#
#   produccion (dentro del compose):  redis://redis:6379/0
#   desarrollo (por tunel SSH a la MV): redis://localhost:6379/1
#
REDIS_URL=redis://localhost:6379/1

# Solo desarrollo: host SSH de la MV donde vive Redis. Si esta puesto, `make dev`
# abre el tunel al arrancar y lo cierra al salir; si no, hay que abrirlo a mano
# con `ssh -N -L 6379:localhost:6379 usuario@mv` o no habra worker.
#
# El puerto local sale de REDIS_URL. Usa un alias de ~/.ssh/config con su
# IdentityFile para no tener que escribir usuario, puerto ni clave aqui.
REDIS_SSH_HOST=usuario@mv
# Puerto de Redis en la MV, si no es el 6379.
#REDIS_SSH_REMOTE_PORT=6379

# Cuantos analisis calcula el worker a la vez (por defecto 2). Permite lanzar
# churn, CRM y soporte en paralelo; dos del mismo modulo siguen yendo en fila
# porque comparten tabla. Cada uno carga el historico de logs en memoria y abre
# sus conexiones contra Postgres, asi que subirlo cuesta RAM y conexiones.
#WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------
# Estructura esperada del secreto en Vault (JSON).
#
# DJANGO_SECURE_SSL es obligatoria (no tiene valor por defecto) y debe ser
# true en produccion: de ella cuelgan la redireccion a HTTPS, HSTS y el flag
# Secure de las cookies de sesion y CSRF. Con DJANGO_DEBUG=false y
# DJANGO_SECURE_SSL=false la aplicacion se niega a arrancar.
#
# {
#   "DJANGOCONFIG": {
#     "DJANGO_SECRET_KEY": "...",
#     "DJANGO_DEBUG": false,
#     "DJANGO_SECURE_SSL": true,
#     "ALLOWED_HOSTS": "localhost,127.0.0.1",
#     "CSRF_TRUSTED_ORIGINS": "http://localhost:8000"
#   },
#   "DBCONFIG": {
#     "DB_NAME": "...",
#     "DB_USER": "...",
#     "DB_PASSWORD": "...",
#     "DB_HOST": "...",
#     "DB_PORT": 5432,
#     "DB_SSLMODE": "require"
#   }
# }
# ---------------------------------------------------------------------
