# ---- ChurnRateAnalyzer - Variables de Entorno ----
# Copie este archivo como .env y complete los valores reales.

# ---- Conexión a PostgreSQL ----
HOST=postgres_container_name
DB=your_database_name
USER=your_db_user
PASS=your_db_password
PORT=5432
# Esquema por defecto donde están las tablas de churn
SCHEMA=public

# ---- Configuración de Django ----
# Clave secreta: generar una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-a-random-secret-key
# Modo depuración (True/False). Desactivar en producción.
DJANGO_DEBUG=True
# Hosts permitidos separados por coma (* para desarrollo)
DJANGO_ALLOWED_HOSTS=*
