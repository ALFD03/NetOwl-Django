# Lo que NO entra en la imagen. El Dockerfile hace `COPY . .`, asi que todo lo
# que no este aqui acaba dentro. Los patrones llevan `**/` cuando tienen que
# valer en cualquier carpeta: sin el, Docker solo los aplica en la raiz.

# --- Secretos ---
# (`logs/`, mas abajo, llevaba las rutas reales de las peticiones servidas en
# desarrollo.)
.env
.env.*
**/*.pem
**/*.key

# --- Control de versiones y documentacion ---
.git
.gitignore
.dockerignore
**/*.md
docs

# --- Python: entornos, cachés y herramientas de desarrollo ---
**/__pycache__
**/*.py[cod]
.venv
venv
.ruff_cache
.mypy_cache
.pytest_cache
requirements-dev.txt
pyproject.toml

# --- Frontend ---
# El bundle lo compila la etapa de frontend; el node_modules local puede ser de
# otra plataforma y taparia el `npm ci` limpio de esa etapa.
node_modules
web/static/dist
eslint.config.js
.prettierrc.json

# --- Desarrollo y despliegue: no se usan dentro del contenedor ---
# El compose se lee desde fuera de la imagen; dev.sh y el Makefile son del puesto.
docker-compose.yml
Makefile
scripts

# --- Salidas locales ---
logs
staticfiles
graphify-out
*.log
*.zip

# --- Editores y asistentes ---
**/.vscode
.idea
.claude
.claudeignore
.codex
.cursor
.github
.agents
skills-lock.json
